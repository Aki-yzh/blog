{
  "name": "astro-blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro check --watch & astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "content:new": "bun scripts/new-content.mjs",
    "content:manage": "bun scripts/manage-content.mjs",
    "content:studio": "bun scripts/manage-content.mjs --preview",
    "content:test": "bun test scripts/content-admin/store.test.mjs scripts/content-admin/server.test.mjs",
    "content:check": "bun scripts/check-content.mjs && bun node_modules/astro/bin/astro.mjs check",
    "lint": "prettier --write  \"**/*.{js,jsx,ts,tsx,md,mdx,svelte,astro}\" && eslint --fix \"src/**/*.{js,ts,jsx,tsx,svelte,astro}\""
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@tailwindcss/vite": "^4.0.0",
    "@vercel/speed-insights": "^1.0.11",
    "@waline/client": "^3.2.1",
    "astro": "^7.3.1",
    "astro-icon": "^1.1.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.1.5",
    "fuse.js": "^7.0.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "mdast-util-to-string": "^4.0.0",
    "node-html-parser": "^6.1.13",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.0",
    "remark-unwrap-images": "^4.0.0",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.33.4",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "unist-util-visit": "^5.0.0",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.1",
    "@types/sanitize-html": "^2.11.0",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/parser": "^7.12.0",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.31.4",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "prettier": "^3.3.0",
    "prettier-config-standard": "^7.0.0",
    "prettier-plugin-astro": "^0.13.0",
    "prettier-plugin-tailwindcss": "^0.5.14"
  }
}
