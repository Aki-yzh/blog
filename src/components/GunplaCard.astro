---
interface Props {
  order: number
  group: string
  officialImages: string[]
  myImages: string[]
  releasePrice: string
  name: string
  brand: string
  purchasePrice: string
  link78: string
  review: string
}
const {
  order,
  group,
  officialImages,
  myImages,
  releasePrice,
  name,
  brand,
  purchasePrice,
  link78,
  review
} = Astro.props
const rawGrade = group.split('/').at(-1) || group
const grade = rawGrade === 'kOTH' ? 'OTH' : rawGrade
const collectionNumber = String(order).padStart(3, '0')
const localizedNameIndex = name.search(/[\u3400-\u9fff\u3040-\u30ff]/)
const modelCode = localizedNameIndex > 0 ? name.slice(0, localizedNameIndex).trim() : ''
const modelName = localizedNameIndex > 0 ? name.slice(localizedNameIndex).trim() : name
const imageSource = (source: string) =>
  /(^|\/)wait\.png$/i.test(source) ? '/images/wait.png' : source
---

<article class='gunpla-card' data-gunpla aria-label={name}>
  <header class='product-head'>
    <p class='product-meta'><span>{brand}</span><span>PERSONAL ARCHIVE</span></p>
    <p class='product-title'>
      {modelCode && <span class='model-code'>{modelCode}</span>}
      <span class='model-name'>{modelName}</span>
    </p>
  </header>
  <div class='image-section'>
    <div class='card-kicker' aria-hidden='true'>
      <span class='grade-badge'>{grade}</span><span>COLLECTION NO. {collectionNumber}</span>
    </div>
    <div class='image-switcher' aria-label='图片类型'>
      <button type='button' class='tab-button active' data-target='official' aria-pressed='true'
        >官方图</button
      >
      <button type='button' class='tab-button' data-target='my' aria-pressed='false'>实物图</button>
    </div>
    {
      [
        { key: 'official', images: officialImages, label: '官方模型图' },
        { key: 'my', images: myImages, label: '实物图' }
      ].map(({ key, images, label }) => (
        <div
          class:list={['image-group', key, { active: key === 'official' }]}
          aria-hidden={key !== 'official'}
          tabindex={images.length > 1 ? 0 : undefined}
          aria-label={name + ' · ' + label + '，左右滑动查看'}
        >
          {images.map((img, index) => (
            <figure class='image-frame'>
              <img
                src={imageSource(img)}
                alt={name + ' · ' + label + ' ' + (index + 1)}
                loading='lazy'
                class='carousel-image'
              />
              <figcaption hidden>图片暂不可用</figcaption>
            </figure>
          ))}
        </div>
      ))
    }
  </div>
  <div class='info-section'>
    <dl>
      <div><dt>万代发售价</dt><dd>{releasePrice}</dd></div>
      <div><dt>购入价</dt><dd>{purchasePrice}</dd></div>
    </dl>
    <div class='review-block' data-index={collectionNumber}>
      <span>BUILD NOTE</span>
      <p class='review'>{review}</p>
    </div>
    <a href={link78} target='_blank' rel='noopener noreferrer' class='details-link'
      >查看模型资料 <span aria-hidden='true'>→</span></a
    >
  </div>
</article>

<style>
  .gunpla-card {
    position: relative;
    display: grid;
    grid-template-areas:
      'head'
      'media'
      'info';
    gap: 0;
    overflow: hidden;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    color: hsl(var(--foreground));
    box-shadow: 0 10px 30px hsl(var(--foreground) / 0.04);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .gunpla-card::before {
    position: absolute;
    z-index: 2;
    inset: 0 auto 0 0;
    width: 3px;
    background: hsl(var(--primary));
    content: '';
  }
  .gunpla-card:hover {
    transform: translateY(-2px);
    border-color: hsl(var(--primary) / 0.45);
    box-shadow: 0 18px 45px hsl(var(--foreground) / 0.09);
  }
  .product-head,
  .image-section,
  .info-section {
    min-width: 0;
  }
  .product-head {
    grid-area: head;
    padding: 1.15rem 1.25rem 1.05rem;
    border-bottom: 1px solid hsl(var(--border));
    background: linear-gradient(110deg, hsl(var(--card)), hsl(var(--secondary) / 0.28));
  }
  .image-section {
    grid-area: media;
    position: relative;
    padding: 3.35rem 1rem 1rem;
    background: radial-gradient(circle at 50% 44%, hsl(var(--background)) 0 28%, transparent 68%),
      linear-gradient(135deg, hsl(var(--secondary) / 0.72), hsl(var(--background)));
    border-bottom: 1px solid hsl(var(--border));
  }
  .image-section::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(hsl(var(--foreground) / 0.025) 1px, transparent 1px),
      linear-gradient(90deg, hsl(var(--foreground) / 0.025) 1px, transparent 1px);
    background-size: 28px 28px;
    content: '';
  }
  .card-kicker {
    position: absolute;
    z-index: 1;
    top: 0.9rem;
    left: 1rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.1em;
  }
  .grade-badge {
    padding: 0.28rem 0.48rem;
    border-radius: 0.3rem;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.67rem;
    letter-spacing: 0.08em;
  }
  .image-switcher {
    position: absolute;
    z-index: 3;
    top: 0.75rem;
    right: 0.85rem;
    display: flex;
    gap: 0.15rem;
    padding: 0.18rem;
    border: 1px solid hsl(var(--border));
    border-radius: 2rem;
    background: hsl(var(--card) / 0.88);
    backdrop-filter: blur(8px);
  }
  .tab-button {
    padding: 0.3rem 0.58rem;
    border-radius: 2rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.68rem;
    cursor: pointer;
  }
  .tab-button.active {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }
  .image-group {
    position: relative;
    z-index: 1;
    display: none;
    gap: 0.65rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-bottom: 0.5rem;
  }
  .image-group.active {
    display: flex;
  }
  .image-frame {
    position: relative;
    flex: 0 0 92%;
    margin: 0;
    aspect-ratio: 1;
    max-height: 330px;
    scroll-snap-align: start;
    border-radius: 0.4rem;
    overflow: hidden;
    background: transparent;
  }
  .image-frame:only-child {
    flex-basis: 100%;
  }
  .carousel-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    margin: 0;
    filter: drop-shadow(0 15px 14px hsl(var(--foreground) / 0.12));
    transition: transform 0.25s ease;
  }
  .gunpla-card:hover .carousel-image {
    transform: scale(1.018);
  }
  figcaption {
    height: 100%;
    align-content: center;
    text-align: center;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
  }
  .info-section {
    grid-area: info;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    padding: 0;
    background: linear-gradient(155deg, hsl(var(--card)) 55%, hsl(var(--secondary) / 0.2));
  }
  .product-head .product-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
    color: hsl(var(--primary));
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.11em;
  }
  .product-head .product-meta span:last-child {
    color: hsl(var(--muted-foreground));
    font-weight: 500;
  }
  .product-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.48em;
    row-gap: 0.12em;
    max-width: 54rem;
    margin: 0;
    font-family: 'Satoshi', 'PingFang SC', 'Microsoft YaHei UI', 'Microsoft YaHei', sans-serif;
    font-size: clamp(1.22rem, 2.05vw, 1.5rem);
    line-height: 1.38;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .model-code {
    color: hsl(var(--muted-foreground));
    font-size: 0.76em;
    font-weight: 650;
    letter-spacing: 0.012em;
  }
  .model-name {
    font-family: 'PingFang SC', 'Microsoft YaHei UI', 'Microsoft YaHei', 'Satoshi', sans-serif;
    font-weight: 620;
    letter-spacing: -0.025em;
    line-break: strict;
    overflow-wrap: break-word;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0.9rem 0.35rem;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--secondary) / 0.16);
    font-size: 0.76rem;
  }
  dl > div {
    display: grid;
    align-content: center;
    gap: 0.28rem;
    min-height: 3rem;
    padding: 0.15rem 0.8rem;
    text-align: center;
  }
  dl > div + div {
    border-left: 1px solid hsl(var(--border));
  }
  dt {
    color: hsl(var(--muted-foreground));
    font-size: 0.64rem;
    font-weight: 550;
    letter-spacing: 0.055em;
  }
  dd {
    margin: 0;
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .review-block {
    position: relative;
    isolation: isolate;
    min-height: 8rem;
    margin: 0;
    padding: 1.15rem 1.25rem 1.4rem;
    overflow: hidden;
  }
  .review-block::after {
    position: absolute;
    z-index: -1;
    right: 0.9rem;
    bottom: -0.5rem;
    color: hsl(var(--foreground) / 0.035);
    content: attr(data-index);
    font-size: clamp(3.3rem, 7vw, 5rem);
    font-variant-numeric: tabular-nums;
    font-weight: 750;
    letter-spacing: -0.075em;
    line-height: 1;
  }
  .review-block > span {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
    color: hsl(var(--primary));
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }
  .review-block > span::after {
    width: 2rem;
    height: 1px;
    background: hsl(var(--primary) / 0.38);
    content: '';
  }
  .review {
    margin: 0;
    max-width: 34ch;
    color: hsl(var(--foreground) / 0.72);
    font-size: 0.8rem;
    line-height: 1.78;
    white-space: pre-line;
  }
  .details-link {
    display: inline-flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    width: 100%;
    padding: 0.85rem 1.2rem;
    border-top: 1px solid hsl(var(--border));
    background: hsl(var(--secondary) / 0.2);
    color: hsl(var(--primary));
    font-size: 0.75rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }
  .details-link span {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    border-radius: 50%;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    transition: transform 0.2s ease;
  }
  .details-link:hover span {
    transform: translateX(2px);
  }
  .details-link:hover {
    background: hsl(var(--primary) / 0.08);
  }
  :is(button, a, .image-group):focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }
  [hidden] {
    display: none !important;
  }
  @media (min-width: 640px) {
    .gunpla-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'head head'
        'media info';
    }
    .image-section {
      border-right: 1px solid hsl(var(--border));
      border-bottom: 0;
    }
  }
  @media (max-width: 420px) {
    .card-kicker > span:last-child {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gunpla-card,
    .carousel-image,
    .details-link span {
      transition: none;
    }
    .gunpla-card:hover,
    .gunpla-card:hover .carousel-image {
      transform: none;
    }
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-gunpla] .tab-button')
    if (!button) return
    const card = button.closest('[data-gunpla]')!
    card.querySelectorAll<HTMLButtonElement>('.tab-button').forEach((tab) => {
      const active = tab === button
      tab.classList.toggle('active', active)
      tab.setAttribute('aria-pressed', String(active))
    })
    card.querySelectorAll<HTMLElement>('.image-group').forEach((group) => {
      const active = group.classList.contains(button.dataset.target!)
      group.classList.toggle('active', active)
      group.setAttribute('aria-hidden', String(!active))
    })
  })
  function showFallback(image: HTMLImageElement) {
    if (!image.matches('[data-gunpla] .carousel-image')) return
    image.hidden = true
    const caption = image.nextElementSibling as HTMLElement | null
    if (caption) caption.hidden = false
  }
  document.addEventListener(
    'error',
    (event) => {
      if (event.target instanceof HTMLImageElement) showFallback(event.target)
    },
    true
  )
  document.querySelectorAll<HTMLImageElement>('[data-gunpla] img').forEach((image) => {
    if (image.complete && image.naturalWidth === 0) showFallback(image)
  })
</script>
