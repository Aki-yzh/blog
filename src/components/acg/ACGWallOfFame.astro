---
import Collapse from '@/components/Collapse.astro'
import ACGCardArrow from './ACGCardArrow.astro'
import ACGTextLines from './ACGTextLines.astro'

interface Props {
  title: string
  images: Array<{
    src: string
    alt: string
  }>
  note: string | string[]
  archive: {
    href: string
    image: string
  }
}

const { title, images, note, archive } = Astro.props
---

<Collapse title={title} class='text-M font-serif'>
  <div class='not-prose mb-4 grid grid-cols-1 items-start gap-4 sm:grid-cols-2'>
    {
      images.map((image) => (
        <div>
          <img
            src={image.src}
            alt={image.alt}
            class='m-0 block h-auto w-full rounded-lg'
            decoding='async'
          />
        </div>
      ))
    }

    <div class='flex flex-col gap-4'>
      <p class='m-0 text-sm leading-relaxed text-muted-foreground'>
        <ACGTextLines value={note} />
      </p>
      <a
        href={archive.href}
        target='_blank'
        rel='noopener noreferrer'
        aria-label='在 GitHub 查看通关存档'
        class='block self-end no-underline'
      >
        <div
          class='group relative overflow-hidden rounded-2xl border border-border bg-background px-4 py-2 transition-colors hover:bg-primary-foreground sm:py-3'
        >
          <div class='relative z-10 flex items-center gap-3'>
            <div class='relative h-16 w-16 min-w-16 overflow-hidden rounded-full'>
              <img
                src={archive.image}
                class='m-0 h-full w-full bg-white object-cover'
                alt='GitHub'
                loading='lazy'
                width='80'
                height='80'
                decoding='async'
              />
              <div class='absolute start-0 top-0 h-full w-full'>
                <div
                  class='flex h-full w-full items-center justify-center rounded-full bg-foreground opacity-0 transition-opacity duration-300 ease-in-out group-hover:opacity-50'
                >
                  <ACGCardArrow />
                </div>
              </div>
            </div>
          </div>
          <img
            src={archive.image}
            class='absolute -start-2 top-0 z-0 my-0 h-full w-2/3 bg-white object-cover opacity-15'
            alt=''
            loading='lazy'
            style='mask-image:linear-gradient(to left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);ms-mask-image:-ms-linear-gradient(to left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%);-webkit-mask-image:-webkit-linear-gradient(to left, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)'
            width='80'
            height='80'
            decoding='async'
          />
        </div>
      </a>
    </div>
  </div>
</Collapse>
