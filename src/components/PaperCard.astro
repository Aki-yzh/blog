---
import type { HTMLAttributes } from 'astro/types'

export interface Props extends HTMLAttributes<'div'> {
  title: string
  authors: string
  publication: string
  year: number
  link?: string
}

const { title, authors, publication, year, link, ...attrs } = Astro.props
---

<div
  class='paper-card not-prose group relative flex flex-col gap-y-2 rounded-2xl border border-border bg-background p-4 transition-colors hover:bg-primary-foreground'
  {...attrs}
>
  <a
    href={link}
    target='_blank'
    rel='noopener noreferrer'
    class='text-lg font-semibold leading-snug text-foreground no-underline'
  >
    {title}
  </a>
  <p class='m-0 text-sm leading-relaxed text-muted-foreground' set:html={authors} />
  <p class='m-0 text-sm leading-relaxed text-muted-foreground'>
    <em>{publication}</em>, {year}
  </p>
</div>
