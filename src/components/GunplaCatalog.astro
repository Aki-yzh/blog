---
import GunplaGroupPanel from '@/components/GunplaGroupPanel.astro'

interface GunplaItem {
  order: number
  group: string
  officialImages: string[]
  myImages: string[]
  name: string
  releasePrice: string
  brand: string
  purchasePrice: string
  link78: string
  review: string
}

interface GunplaGroup {
  depth: number
  id: string
  text: string
  tocText: string
  key: string
  parent: string | null
  order: number
}

interface Props {
  items: GunplaItem[]
  groups: GunplaGroup[]
}

const { items, groups } = Astro.props
const sortedGroups = [...groups].sort((left, right) => left.order - right.order)
const sortedItems = [...items].sort((left, right) => left.order - right.order)
const groupKeys = new Set(sortedGroups.map((group) => group.key))
const groupOrders = new Set(sortedGroups.map((group) => group.order))

if (groupKeys.size !== sortedGroups.length) {
  throw new Error('Gunpla group manifest contains duplicate keys')
}

if (groupOrders.size !== sortedGroups.length) {
  throw new Error('Gunpla group manifest contains duplicate order values')
}

const itemOrders = new Set(sortedItems.map((item) => item.order))
if (itemOrders.size !== sortedItems.length) {
  throw new Error('Gunpla entries contain duplicate order values')
}

for (const item of sortedItems) {
  if (!groupKeys.has(item.group)) {
    throw new Error(`Gunpla entry #${item.order} references unknown group ${item.group}`)
  }
}

const itemsByGroup = new Map<string, GunplaItem[]>()
for (const item of sortedItems) {
  const groupItems = itemsByGroup.get(item.group) ?? []
  groupItems.push(item)
  itemsByGroup.set(item.group, groupItems)
}
const brands = [...new Set(sortedItems.map((item) => item.brand))].sort()
const leafGroups = sortedGroups.filter(
  (group) => !sortedGroups.some((child) => child.parent === group.key)
)
const topGroups = sortedGroups.filter((group) => group.parent === null)
const childrenOf = (key: string) => sortedGroups.filter((group) => group.parent === key)
const itemCountUnder = (key: string) =>
  sortedItems.filter((item) => item.group === key || item.group.startsWith(`${key}/`)).length
---

<section class='catalog-tools not-prose' aria-label='模型筛选'>
  <div class='catalog-intro'>
    <span>COLLECTION</span><strong>{items.length} 台模型 · {leafGroups.length} 个分组</strong>
  </div>
  <p>按名称、品牌或简评查找，展开分组查看收藏。</p>
  <div class='catalog-filters'>
    <label class='search-field'
      >搜索<input id='gunpla-search' type='search' placeholder='例如：巴巴托斯、扎古…' /></label
    >
    <label
      >品牌<select id='gunpla-brand'
        ><option value=''>全部品牌</option>{
          brands.map((brand) => <option value={brand}>{brand}</option>)
        }</select
      ></label
    >
    <label
      >分组<select id='gunpla-group'
        ><option value=''>全部分组</option>{
          leafGroups.map((group) => <option value={group.key}>{group.key}</option>)
        }</select
      ></label
    >
  </div>
  <div class='catalog-actions'>
    <span id='gunpla-results' role='status' aria-live='polite'>共 {items.length} 台模型</span>
    <div>
      <button type='button' id='gunpla-reset'>清空筛选</button><button
        type='button'
        id='gunpla-expand'>展开全部</button
      ><button type='button' id='gunpla-collapse'>收起全部</button>
    </div>
  </div>
</section>
<p id='gunpla-empty' hidden>没有找到符合条件的模型，试试其他关键词或清空筛选。</p>
<div id='gunpla-catalog'>
  {
    topGroups.map((topGroup) => (
      <section class='collection-branch' data-catalog-branch>
        <h2 id={topGroup.id}>{topGroup.text}</h2>
        <div class:list={['collection-groups', { 'ko-brands': topGroup.key === 'KO' }]}>
          {childrenOf(topGroup.key).map((group) => {
            const childGroups = childrenOf(group.key)
            const isLeaf = childGroups.length === 0

            if (isLeaf) {
              return (
                <GunplaGroupPanel
                  group={group}
                  items={itemsByGroup.get(group.key) ?? []}
                  variant={topGroup.key === 'KO' ? 'brand' : 'line'}
                  open={group === leafGroups[0]}
                />
              )
            }

            return (
              <details class='brand-cluster not-prose' id={group.id} data-catalog-branch>
                <summary class='brand-summary'>
                  <span>
                    {group.text}
                    <small>KO 品牌 · {childGroups.length} 条产品线</small>
                  </span>
                  <span class='group-count'>{itemCountUnder(group.key)} 台</span>
                </summary>
                <div class='brand-products'>
                  {childGroups.map((child) => (
                    <GunplaGroupPanel
                      group={child}
                      items={itemsByGroup.get(child.key) ?? []}
                      variant='line'
                    />
                  ))}
                </div>
              </details>
            )
          })}
        </div>
      </section>
    ))
  }
</div>

<style>
  .catalog-tools {
    padding: 1.25rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    background: linear-gradient(135deg, hsl(var(--card)), hsl(var(--secondary) / 0.38));
    color: hsl(var(--foreground));
  }
  .catalog-intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
  }
  .catalog-intro span {
    color: hsl(var(--primary));
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }
  .catalog-intro strong {
    font-size: 0.85rem;
    font-weight: 500;
  }
  .catalog-tools p {
    margin: 0.6rem 0 1rem;
    font-size: 0.85rem;
    color: hsl(var(--muted-foreground));
  }
  .catalog-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .catalog-filters label {
    flex: 1 1 130px;
    display: grid;
    gap: 0.4rem;
    font-size: 0.8rem;
    min-width: 0;
  }
  .catalog-filters .search-field {
    flex-basis: 100%;
  }
  .catalog-filters input,
  .catalog-filters select {
    width: 100%;
    min-width: 0;
    padding: 0.65rem 0.7rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    background: hsl(var(--background));
    color: inherit;
    font: inherit;
  }
  .catalog-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.75rem;
  }
  .catalog-actions > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  button {
    cursor: pointer;
    color: hsl(var(--primary));
  }
  button:hover {
    text-decoration: underline;
  }
  .collection-groups :global(.catalog-group),
  .brand-cluster {
    margin: 0.75rem 0;
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    overflow: hidden;
    color: hsl(var(--foreground));
    scroll-margin-top: 5rem;
  }
  .collection-groups :global(summary) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    cursor: pointer;
    list-style: none;
    background: linear-gradient(90deg, hsl(var(--card)), hsl(var(--secondary) / 0.35));
  }
  .collection-groups :global(summary::-webkit-details-marker) {
    display: none;
  }
  .collection-groups :global(summary::before) {
    content: '›';
    font-size: 1.3rem;
    transition: transform 0.15s;
  }
  .collection-groups :global(details[open] > summary::before) {
    transform: rotate(90deg);
  }
  .collection-groups :global(details[open] > summary) {
    border-bottom: 1px solid hsl(var(--border));
  }
  .collection-groups :global(summary > span:first-of-type) {
    flex: 1;
    font-weight: 600;
  }
  .collection-groups :global(summary small) {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.7rem;
    font-weight: 400;
    color: hsl(var(--muted-foreground));
  }
  .collection-groups :global(.group-count) {
    padding: 0.28rem 0.56rem;
    border-radius: 2rem;
    background: hsl(var(--primary) / 0.08);
    color: hsl(var(--primary));
    font-size: 0.68rem;
  }
  .collection-groups :global(.group-items) {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    background: hsl(var(--secondary) / 0.18);
  }
  .collection-groups :global(.show-more) {
    display: block;
    margin: 0 auto 1rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid hsl(var(--border));
    font-size: 0.8rem;
  }
  [hidden] {
    display: none !important;
  }
  .collection-branch[hidden],
  .brand-cluster[hidden],
  .collection-groups :global([hidden]) {
    display: none !important;
  }
  .collection-branch > h2 {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 2.25rem 0 0.85rem;
    color: hsl(var(--foreground));
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .collection-branch > h2::after {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, hsl(var(--primary) / 0.4), transparent);
    content: '';
  }
  .ko-brands > :global(.brand-group),
  .ko-brands > .brand-cluster {
    margin-block: 0.85rem;
  }
  .ko-brands > :global(.brand-group > summary),
  .brand-cluster > .brand-summary {
    min-height: 4.5rem;
    background: linear-gradient(90deg, hsl(var(--card)), hsl(var(--primary) / 0.065));
  }
  .ko-brands > :global(.brand-group > summary > span:first-of-type),
  .brand-cluster > .brand-summary > span:first-of-type {
    font-size: 1rem;
    letter-spacing: 0.035em;
  }
  .brand-products {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem 1rem 1rem 1.6rem;
    background: hsl(var(--secondary) / 0.18);
    border-left: 2px solid hsl(var(--primary) / 0.35);
  }
  .brand-products :global(.catalog-group) {
    margin: 0;
    background: hsl(var(--background));
  }
  :is(input, select, button):focus-visible,
  .collection-groups :global(summary:focus-visible) {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .collection-groups :global(summary::before) {
      transition: none;
    }
  }
</style>

<script>
  const catalog = document.querySelector<HTMLElement>('#gunpla-catalog')
  if (catalog) {
    const search = document.querySelector<HTMLInputElement>('#gunpla-search')!
    const brand = document.querySelector<HTMLSelectElement>('#gunpla-brand')!
    const group = document.querySelector<HTMLSelectElement>('#gunpla-group')!
    const result = document.querySelector<HTMLElement>('#gunpla-results')!
    const sections = [
      ...catalog.querySelectorAll<HTMLDetailsElement>('details[data-catalog-section]')
    ]
    const allDetails = [...catalog.querySelectorAll<HTMLDetailsElement>('details')]
    const branches = [...catalog.querySelectorAll<HTMLElement>('[data-catalog-branch]')].reverse()
    const limits = new Map(sections.map((element) => [element, 6]))
    let savedOpen: boolean[] | null = null
    const render = () => {
      const query = search.value.trim().normalize('NFKC').toLowerCase()
      const terms = query.split(/\s+/).filter(Boolean)
      const filtering = !!(query || brand.value || group.value)
      if (filtering && !savedOpen) savedOpen = allDetails.map((element) => element.open)
      let count = 0
      for (const section of sections) {
        const cards = [...section.querySelectorAll<HTMLElement>('[data-catalog-item]')]
        const matching = cards.filter(
          (card) =>
            (!brand.value || card.dataset.brand === brand.value) &&
            (!group.value || section.dataset.groupKey === group.value) &&
            terms.every((term) => card.dataset.search!.includes(term))
        )
        const visible = new Set(matching.slice(0, limits.get(section)!))
        cards.forEach((card) => {
          card.hidden = !visible.has(card)
        })
        section.hidden = matching.length === 0 && filtering
        section.querySelector('.group-count')!.textContent = filtering
          ? `${matching.length} / ${cards.length} 台`
          : `${cards.length} 台`
        const more = section.querySelector<HTMLButtonElement>('.show-more')!
        more.hidden = visible.size === matching.length
        more.textContent = `再显示 ${Math.min(6, matching.length - visible.size)} 台（还有 ${matching.length - visible.size} 台）`
        if (filtering && matching.length) {
          section.open = true
          let ancestor = section.parentElement?.closest<HTMLDetailsElement>('details') ?? null
          while (ancestor) {
            ancestor.open = true
            ancestor = ancestor.parentElement?.closest<HTMLDetailsElement>('details') ?? null
          }
        }
        count += matching.length
      }
      branches.forEach((branch) => {
        branch.hidden = filtering && !branch.querySelector('[data-catalog-section]:not([hidden])')
      })
      if (!filtering && savedOpen) {
        allDetails.forEach((element, i) => {
          element.open = savedOpen![i]
        })
        savedOpen = null
      }
      result.textContent = filtering ? `找到 ${count} 台模型` : `共 ${count} 台模型`
      document.querySelector<HTMLElement>('#gunpla-empty')!.hidden = count !== 0
    }
    const filter = () => {
      sections.forEach((element) => limits.set(element, 6))
      render()
    }
    search.addEventListener('input', filter)
    brand.addEventListener('change', filter)
    group.addEventListener('change', filter)
    document.querySelector('#gunpla-reset')!.addEventListener('click', () => {
      search.value = ''
      brand.value = ''
      group.value = ''
      filter()
    })
    document.querySelector('#gunpla-expand')!.addEventListener('click', () =>
      allDetails.forEach((element) => {
        element.open = true
      })
    )
    document.querySelector('#gunpla-collapse')!.addEventListener('click', () =>
      allDetails.forEach((element) => {
        element.open = false
      })
    )
    sections.forEach((element) =>
      element.querySelector('.show-more')!.addEventListener('click', () => {
        limits.set(element, limits.get(element)! + 6)
        render()
      })
    )
    const revealAnchor = () => {
      let id: string
      try {
        id = decodeURIComponent(location.hash.slice(1))
      } catch {
        return
      }
      const target = id && document.getElementById(id)
      if (!target || !catalog.contains(target)) return
      if (target.closest<HTMLElement>('[data-catalog-section]')?.hidden) {
        search.value = ''
        brand.value = ''
        group.value = ''
        filter()
      }
      let details =
        target instanceof HTMLDetailsElement
          ? target
          : target.closest<HTMLDetailsElement>('details')
      while (details) {
        details.open = true
        details = details.parentElement?.closest<HTMLDetailsElement>('details') ?? null
      }
      target.scrollIntoView({ block: 'start' })
    }
    render()
    revealAnchor()
    window.addEventListener('hashchange', revealAnchor)
  }
</script>
