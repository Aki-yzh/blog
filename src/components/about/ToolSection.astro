---
import { cn } from '@/utils'

const iconUrls = import.meta.glob('../../icons/*.svg', {
  eager: true,
  query: '?url',
  import: 'default'
}) as Record<string, string>

const iconUrlFor = (name: string) => iconUrls[`../../icons/${name}.svg`]

interface Props {
  class?: string
  title: string
  tools: {
    name: string
    description: string
    href: string
    iconPath: string
  }[]
}
const { class: className, title, tools, ...props } = Astro.props
---

<div
  class={cn(
    className,
    'not-prose flex flex-col gap-y-3 rounded-xl border border-border px-3 py-3 sm:gap-y-4'
  )}
  {...props}
>
  <div class='m-0 px-2 text-lg font-medium'>{title}</div>
  <div class='grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2 sm:gap-y-4'>
    {
      tools.map((tool) => (
        <a
          class='group relative text-sm leading-normal no-underline hover:bg-transparent '
          href={tool.href}
          id={tool.name}
          target='_blank'
          rel='noopener noreferrer'
        >
          <div class='relative flex flex-row items-center gap-x-4 px-2 py-1.5 transition-all'>
            <div class='absolute -inset-0 z-10 rounded-lg border border-border bg-muted opacity-0 transition-all group-hover:opacity-50' />
            <img
              src={iconUrlFor(tool.iconPath)}
              alt=''
              aria-hidden='true'
              class='z-20 h-10 w-10 rounded-lg bg-muted p-2'
              loading='lazy'
              decoding='async'
            />
            <div class='z-20 flex flex-col'>
              <div class='font-medium'>{tool.name}</div>
              <div class='font-normal text-muted-foreground'>{tool.description}</div>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</div>
