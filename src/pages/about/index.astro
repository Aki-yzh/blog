---
import Timeline from '@/components/Timeline.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import Comment from '@/components/Comment.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import Substats from '@/components/about/Substats.astro'
import Spoiler from '@/components/Spoiler.astro'
import PublicationList from '@/components/PublicationList.astro'
import { getCollection } from 'astro:content'

const headings = [
  {
    depth: 2,
    slug: 'about',
    text: 'about'
  },
  {
    depth: 2,
    slug: 'Pub',
    text: 'Pub'
  },
  {
    depth: 2,
    slug: 'tools',
    text: 'Tools'
  },
  {
    depth: 2,
    slug: 'social-networks',
    text: 'Social Networks'
  },
  {
    depth: 2,
    slug: 'Education',
    text: 'Education'
  },
  {
    depth: 2,
    slug: 'about-blog',
    text: 'About Blog'
  }
]

const publications = await getCollection('publications')
---

<PageLayout title='About' headings={headings} info='/about'>

 <section class='about-profile not-prose' aria-labelledby='about'>
  <div class='profile-identity'>
   <p class='profile-kicker'>ABOUT · BEIJING</p>
   <h2 id='about'>Aki</h2>
   <p class='profile-role'>CS PhD Candidate</p>
   <p class='profile-side'>Jolo / Otaku</p>
  </div>
  <p class='profile-bio'>
        PKU EECS21 毕业、CS PhD 25在读的一只落魄鼠鼠<br>
        阿宅一只，看的动漫还算多<br>
        半个胶佬，因为钱包空空所以玩的国产翻模更多一点<br>
        目前在做普适计算的相关研究
  </p>
  <p class='profile-motto'><span>MOTTO</span><span>身構えているときには、死神は来ないものだ。</span><Spoiler>做好准备的时候，死神是不会来的。</Spoiler></p>
 </section>
  
  <h2 id='Pub'>Publications</h2>
 

  <PublicationList items={publications} />

  <!-- tools -->
  <h2 id='tools'>Tools</h2>
  <p>A compact snapshot of the tools I use every day.</p>
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Safari',
        description: 'Browser',
        href: 'https://www.apple.com/safari/',
        iconPath: 'safari'
      },
      {
        name: 'Chrome',
        description: 'Browser',
        href: 'https://www.google.com/chrome/',
        iconPath: 'chrome'
      },
      {
        name: 'Obsidian',
        description: 'Markdown Editor',
        href: 'https://obsidian.md',
        iconPath: 'illustrator'
      },
      {
        name: 'Foxit',
        description: 'PDF Viewer and Editor',
        href: 'https://www.foxitsoftware.cn/foxitoffice/',
        iconPath: 'firefox'
      },
      {
        name: 'OBS',
        description: 'Live Video Capture',
        href: 'https://obsproject.com/',
        iconPath: 'neovim'
      },

    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'Claude',
        description: 'AI coding',
        href: 'https://claude.com/',
        iconPath: 'claude-color'
      },
      {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        iconPath: 'vscode'
      },
      {
        name: 'QT',
        description: 'IDE',
        href: 'https://www.qt.io',
        iconPath: 'qt'
      },
      {
        name: 'MATLAB',
        description: 'IDE',
        href: 'https://ww2.mathworks.cn/',
        iconPath: 'aftereffects'
      },
      {
        name: 'Docker',
        description: 'Developer Tool',
        href: 'https://www.docker.com/',
        iconPath: 'warp'
      },
      
    ]}
  />

  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Ubuntu 22.04 LTS',
        description: 'Linux',
        href: 'https://ubuntu.com/',
        iconPath: 'ubuntu'
      },
      {
        name: 'Raspberry Pi OS',
        description: 'Linux on Raspberry Pi',
        href: 'https://www.raspberrypi.com/software/',
        iconPath: 'archlinux'
      },
      {
        name: 'macOS Sonoma',
        description: 'MacBook Pro',
        href: 'https://www.apple.com/macos/',
        iconPath: 'apple'
      },
      {
        name: 'Windows 11',
        description: 'Desktop setup',
        href: 'https://news.microsoft.com/windows11-general-availability/',
        iconPath: 'windows11'
      }
    ]}
  />



  <!-- social-networks -->
  <h2 id='social-networks'>Social Networks</h2>
  <p>
      
  </p>
  <Substats />




  <h2 id='Education'>Education</h2>
  <Timeline
    events={[
      {
        date: '2025-08-20',
        content:
          '<a href="https://cs.pku.edu.cn" target="_blank" rel="noopener noreferrer">School of Computer Science, Peking University</a>'
      },
      {
        date: '2021-08-26',
        content:
          '<a href="https://eecs.pku.edu.cn" target="_blank" rel="noopener noreferrer">The School of Electronics Engineering and Computer Science, Peking University</a>'
      },
      {
        date: '2018-09-01',
        content: '<a href="https://www.jkfz.cn" target="_blank" rel="noopener noreferrer">Jiangxi University of Technology High School</a>'
      }
    ]}
  />
<!-- about-blog -->
 <h2 id='about-blog'>About blog</h2>
  <p>本站基于以下项目/服务提供商的资源和技术支持：</p>
  <ul>
    <li>
      Framework & Theme: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>
      Site hosting and  HTTPS certification: <a href='https://vercel.com/' target='_blank'>Vercel</a>
    </li>
    <li>
      CI/CD: <a href='https://vercel.com/workflow' target='_blank'>Vercel Workflow</a>
    </li>
    <li>
      DNS resolution: <a href='https://dash.cloudflare.com' target='_blank'>Cloudflare</a> + <a href='https://dc.console.aliyun.com' target='_blank'>Aliyun</a> 
    </li>
    <li>Comment system：<a href='https://waline.js.org' target='_blank'>Waline</a></li>
    <li>
      Visits: <a href='https://supabase.com/' target='_blank'>Supabase</a> +
      <a href='https://waline.js.org/' target='_blank'>Waline</a>
    </li>
    <li>
      Follower statistics: <a href='https://github.com/spencerwooo/substats' target='_blank'
        >Substats</a
      >
    </li>
        <li>
      to be continued with other pages such as GUNPLA and ANIME
      
    </li>
  </ul>
  <Comment slot='bottom' />
</PageLayout>

<style>
  :global(#Pub),
  :global(#tools),
  :global(#social-networks),
  :global(#Education),
  :global(#about-blog) {
    scroll-margin-top: 5rem;
  }
  .about-profile {
    display: grid;
    grid-template-areas:
      'identity bio'
      'motto motto';
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: 1.75rem 2.25rem;
    margin-bottom: 2.5rem;
    padding: 1.75rem 0 1.15rem;
    border-top: 2px solid hsl(var(--primary));
    border-bottom: 1px solid hsl(var(--border));
  }
  .profile-identity {
    grid-area: identity;
    padding-right: 2rem;
    border-right: 1px solid hsl(var(--border));
  }
  .profile-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 0.7rem;
    color: hsl(var(--primary));
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .profile-kicker::before {
    width: 1.8rem;
    height: 1px;
    background: currentColor;
    content: '';
  }
  .about-profile h2 {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }
  .profile-role {
    margin: 0.65rem 0 0;
    color: hsl(var(--foreground) / 0.82);
    font-size: 0.85rem;
    font-weight: 520;
  }
  .profile-side {
    margin: 0.2rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .profile-bio {
    grid-area: bio;
    align-self: center;
    margin: 0;
    color: hsl(var(--foreground) / 0.82);
    font-size: 0.96rem;
    line-height: 1.9;
  }
  .profile-motto {
    display: flex;
    grid-area: motto;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid hsl(var(--border));
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
  }
  .profile-motto > span:first-child {
    flex: none;
    color: hsl(var(--primary));
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  @media (max-width: 639px) {
    .about-profile {
      grid-template-areas:
        'identity'
        'bio'
        'motto';
      grid-template-columns: minmax(0, 1fr);
      gap: 1.2rem;
      padding-top: 1.35rem;
    }
    .profile-identity {
      padding: 0 0 1.1rem;
      border-right: 0;
      border-bottom: 1px solid hsl(var(--border));
    }
    .profile-motto {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 0.5rem 0.7rem;
    }
  }
</style>
