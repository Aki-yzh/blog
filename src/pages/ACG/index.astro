---
import { getCollection } from 'astro:content'
import PageLayout from '@/layouts/CommonPage.astro'
import Collapse from '@/components/Collapse.astro'
import Button from '@/components/Button.astro'
import ACGCompactCard from '@/components/acg/ACGCompactCard.astro'
import ACGFeaturedCard from '@/components/acg/ACGFeaturedCard.astro'
import ACGTimeline from '@/components/acg/ACGTimeline.astro'
import ACGWallOfFame from '@/components/acg/ACGWallOfFame.astro'
import acgPage from '../../data/acg-page.json'

const entries = await getCollection('acg')
const animeFeatured = entries
  .flatMap(({ data }) => (data.section === 'anime-featured' ? [data] : []))
  .sort((left, right) => left.order - right.order)
const animeMore = entries
  .flatMap(({ data }) => (data.section === 'anime-more' ? [data] : []))
  .sort((left, right) => left.order - right.order)
const animeTimeline = entries
  .flatMap(({ data }) => (data.section === 'anime-timeline' ? [data] : []))
  .sort((left, right) => right.year - left.year || left.order - right.order)
const comicFeatured = entries
  .flatMap(({ data }) => (data.section === 'comic-featured' ? [data] : []))
  .sort((left, right) => left.order - right.order)
const games = entries
  .flatMap(({ data }) => (data.section === 'game' ? [data] : []))
  .sort((left, right) => left.order - right.order)

const placementKeys = entries.map(({ data }) =>
  data.section === 'anime-timeline'
    ? `${data.section}:${data.year}:${data.order}`
    : `${data.section}:${data.order}`
)
if (new Set(placementKeys).size !== placementKeys.length) {
  throw new Error('ACG entries contain duplicate section/year/order placements')
}
if (acgPage.bangumi.detail.href !== acgPage.bangumi.detail.iframeSrc) {
  throw new Error('ACG Detail link and iframe must use the same URL')
}
const recentActivityHref =
  acgPage.bangumi.recentActivity.href.trim() ||
  acgPage.bangumi.detail.href.replace(/\/(?:anime|book)\/list\/([^/]+).*$/, '/user/$1')
const recentActivityImage = acgPage.bangumi.recentActivity.image.replace(
  /^http:\/\//,
  'https://'
)

const headings = [
  {
    depth: 2,
    slug: 'Anime',
    text: 'Anime'
  },
  {
    depth: 2,
    slug: 'Comic',
    text: 'Comic'
  },
  {
    depth: 2,
    slug: 'Game',
    text: 'Game'
  },
  {
    depth: 2,
    slug: 'Detail',
    text: 'Detail'
  }
]
---

<PageLayout title='ACG' headings={headings} info='/ACG'>
  <p>
    &nbsp;&nbsp;18年开始，番剧和漫画看的比较多，游戏比较少，算半个宅宅吧（）<br />
  </p>

  <h2 id='Anime'>Anime</h2>
  <p>
    &nbsp;&nbsp;番剧太多就不列举了，详情查看<a href='#Detail'>Detail</a><br />
    &nbsp;&nbsp;这里推荐两部，一部是所有的最推荐，一部是近期最推荐<br />
    &nbsp;&nbsp;<a href='#timeline'>timeline</a>为从18年开始每年最推荐的几部当年番
  </p>

  <div class='animate grid w-full grid-cols-1 gap-2 sm:grid-cols-2'>
    {
      animeFeatured.map((item) => (
        <ACGFeaturedCard
          badge={item.badge}
          title={item.title}
          description={item.description}
          image={item.image}
          link={item.link}
        />
      ))
    }
  </div>

  <Collapse title='Want more?'>
    <div class='animate grid grid-rows-4 gap-3.5 sm:grid-cols-2 sm:gap-4 lg:grid-cols-2'>
      {
        animeMore.map((item) => (
          <ACGCompactCard
            title={item.title}
            description={item.description}
            image={item.image}
            link={item.link}
          />
        ))
      }
      <Button
        title={acgPage.bangumi.seeMore.title}
        class='ml-auto w-fit px-6 py-3 text-lg'
        href={acgPage.bangumi.seeMore.href}
        style='ahead'
      />
    </div>
  </Collapse>

  <h3 id='timeline'>timeline</h3>
  <p>
    除非特别说明第几季，否则推荐过的动漫的续作或者前作均推荐<br />
    没列出来的也不是不推荐，相反，没列出来的也有很多我很喜欢的作品，我列在这的单纯是我觉得要列在这的，没有什么标准
  </p>
  <ACGTimeline items={animeTimeline} />

  <h2 id='Comic'>Comic</h2>
  <p>
    &nbsp;&nbsp;漫画就不列举了，详情查看<a href='#Detail'>Detail</a><br />
    &nbsp;&nbsp;因为看过的很多都动画化了，所以也不在banggumi里面<br />
    &nbsp;&nbsp;这里就推荐两部，一部是所有的最推荐，一部是近期最推荐
  </p>

  <div class='animate grid w-full grid-cols-1 gap-2 sm:grid-cols-2'>
    {
      comicFeatured.map((item) => (
        <ACGFeaturedCard
          badge={item.badge}
          title={item.title}
          description={item.description}
          image={item.image}
          link={item.link}
        />
      ))
    }
  </div>

  <h2 id='Game'>Game</h2>
  <div class='animate grid gap-3.5 sm:grid-cols-2 sm:gap-4 lg:grid-cols-2'>
    {
      games.map((item) => (
        <ACGCompactCard
          title={item.title}
          description={item.description}
          image={item.image}
          link={item.link}
        />
      ))
    }
  </div>

  <ACGWallOfFame
    title={acgPage.wallOfFame.title}
    images={acgPage.wallOfFame.images}
    note={acgPage.wallOfFame.note}
    archive={acgPage.wallOfFame.archive}
  />

  <h2 id='Detail'>Detail</h2>
  <p>
    &nbsp;&nbsp;番剧记录基本都在banggumi里，展开查看或<a
      href={acgPage.bangumi.detail.href}
      target='_blank'
      rel='noopener noreferrer'>跳转</a
    >
  </p>

  <Collapse title='详细信息'>
    <div style='width: 100%; height: 120vh; position: relative; overflow-x: hidden;'>
      <iframe
        title='Bangumi 动画与漫画收藏详情'
        loading='lazy'
        width='100%'
        height='100%'
        style='border:none; position: absolute; top: 0; left: 0;'
        data-src={acgPage.bangumi.detail.iframeSrc}></iframe>
    </div>
  </Collapse>
</PageLayout>

<div
  class='fixed bottom-[25%] right-[3%] z-10 hidden max-w-[320px] translate-y-1/2 transform flex-col items-start min-[1800px]:flex'
>
  <p class='rounded-lg text-gray-500'>Recent Activities:</p>
  <br />
  <a
    href={recentActivityHref}
    target='_blank'
    rel='noopener noreferrer'
    class='relative flex items-center justify-center'
  >
    <img
      src={recentActivityImage}
      alt='AKI 的个人主页'
      loading='lazy'
      decoding='async'
      class='rounded-lg object-cover'
      style='z-index: 1;'
    />
    <div
      style='position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 0.5rem; background: linear-gradient(45deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 1) 100%); pointer-events: none;'
    >
    </div>
  </a>
</div>
