---
import { getCollection } from 'astro:content'

import GunplaCatalog from '@/components/GunplaCatalog.astro'
import PageLayout from '@/layouts/CommonPage.astro'

import gunplaGroups from '../../data/gunpla-groups.json'

const gunpla = await getCollection('gunpla')
const groups = [...gunplaGroups.groups].sort((left, right) => left.order - right.order)
const headings = groups.map(({ depth, id, tocText }) => ({
  depth,
  slug: id,
  text: tocText
}))
---

<PageLayout title='Gunpla' headings={headings} info='/Gunpla'>
  <GunplaCatalog items={gunpla.map(({ data }) => data)} groups={groups} />
</PageLayout>
